```{r setup, include=FALSE}
library(tidyverse)
library(DT)
library(readxl)
library(plotly)
library(readr)
library(dplyr)
```

## NCBI NR BLAST

```{r, echo=FALSE}
# Read the CSV file
nr_data <- read_csv("{{ data_sources.nr_blast }}")

# Subset the relevant columns
nr_subset <- nr_data[, c("query_name", "nr.hit_name", "description", "E value")]

# Create interactive datatable
datatable(
  nr_subset,
  extensions = 'Buttons',
  options = list(
    dom = 'Bfrtip',
    buttons = c('copy', 'csv', 'excel', 'pdf', 'print'),
    pageLength = 4
  ),
  filter = "top",
  rownames = FALSE
)
```

## UniProt

```{r, echo=FALSE}
# Read the tab-delimited file from the URL
