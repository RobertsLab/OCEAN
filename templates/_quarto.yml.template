project:
  type: website
  output-dir: ../docs  # Goes to root-level docs/ folder

website:
  title: "{{ website.title }}"
  navbar:
    left:
      - text: About
        file: about.qmd
      - text: Annotations
        href: explore.qmd
      - text: Genome Browser
        href: jbrowse/index.html
    right:
      - icon: github
        href: {{ website.github_repo }}
        aria-label: GitHub

format:
  html:
    theme: {{ website.theme }}
    css: styles.css
    toc: true